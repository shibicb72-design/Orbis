# Known, accepted gap for libtorrent in the Engine currency check (scripts/check_engine_currency.py).
#
# LIBTORRENT_ACCEPTED_NEWEST is the newest upstream libtorrent release (github.com/arvidn/libtorrent) that the
# owner has accepted NOT being bundled yet. While the bundled libtorrent (LIBTORRENT_VERSION in
# native/libtorrent4j/versions.env) is behind and the newest upstream release equals this value, the check prints
# "BEHIND (accepted up to <version>)" and stays green. When upstream releases anything newer, the check goes red.
# When the bundled libtorrent catches up, the check exits 2 until this line is removed.
#
# Only Shibi's decision changes this file. Set 2026-11-16 (newest upstream release v2.1.2, bundled 2.1.0.0).
# Background: docs/security/NATIVE-VERSIONS.md ("libtorrent 2.1.2 (PR 7b): stopped").
LIBTORRENT_ACCEPTED_NEWEST=2.1.2
