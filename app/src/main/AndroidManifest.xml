<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- SSDP for DLNA, and mDNS for Chromecast. MulticastLock only. Nearby Wi-Fi is required by NsdManager on
         Android 13+ and is not used to derive location. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!-- Asked at runtime only when a site requests them. No background location. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Download longevity: ongoing notification from a dataSync foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Page audio/video keeps playing in the background with media controls. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Settings > Passwords asks for the screen lock / fingerprint through Android's own prompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- browser-engine-gecko pulls in support-utils, which merges QUERY_ALL_PACKAGES.
         Play treats that as a sensitive permission. Visibility is declared in <queries> below. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"
        tools:node="remove" />

    <!-- The camera and location permissions above must not filter out devices without the hardware. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <!-- Which installed apps open a link (Open in app), visible since Android 11 only when declared. -->
    <queries>
        <!-- Voice search: the phone's speech recognizer. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" android:host="*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="market" />
        </intent>
        <!-- magnet: has no host. A query with host="*" does not see those filters, so uTorrent stays invisible to
             resolveActivity. startActivity is still tried; this entry lets the prompt name the app when it is there. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="magnet" />
        </intent>
        <!-- An app's own scheme (zoommtg:) and any other browsable view handler that names a host.
             In <queries>, "*" is a wildcard, and host is required to see filters that name one.
             Hostless schemes (magnet:) are listed on their own above. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="*" android:host="*" />
        </intent>
    </queries>

    <application
        android:name=".OrbisApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        tools:targetApi="33"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbis"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|orientation|screenSize|locale|layoutDirection|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- PDF and HTML opened from another app (WhatsApp sends ACTION_VIEW with a content: URI and a MIME type).
                 data attributes in one filter are not pairs. Every scheme matches every MIME type: the filter
                 collects them into two lists and an intent matches when its scheme is in one and its type is in
                 the other. Only content is listed, so file: is not claimed. A MIME type with no scheme would also
                 match file: (the platform assumes content: and file: in that case). text/plain is intentionally
                 absent. application/xhtml+xml is not claimed: a CSP meta in XHTML can be bypassed. DEFAULT is what
                 the chooser requires. BROWSABLE is omitted so a web page cannot navigate here; an intent that also
                 carries BROWSABLE will not match. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="content" android:mimeType="text/html" />
            </intent-filter>
            <!-- Share sheet. SEND carries the MIME on the intent and the URI in EXTRA_STREAM, so this filter
                 names types only (a scheme would require a data URI the share intent does not have). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/html" />
            </intent-filter>
        </activity>

        <!-- Every web link from another app comes in here and is routed: Custom Tab or the browser. -->
        <activity
            android:name=".LinkRouterActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".customtabs.CustomTabActivity"
            android:exported="false"
            android:autoRemoveFromRecents="true"
            android:taskAffinity=""
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|orientation|screenSize|locale|layoutDirection|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".widget.SearchWidget"
            android:exported="false"
            android:label="@string/widget_search_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_search_info" />
        </receiver>

        <service
            android:name=".customtabs.OrbisCustomTabsService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.support.customtabs.action.CustomTabsService" />
            </intent-filter>
        </service>

        <service
            android:name=".media.MediaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".cast.CastActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.shibi.orbis.cast.PLAY" />
                <action android:name="com.shibi.orbis.cast.PAUSE" />
                <action android:name="com.shibi.orbis.cast.STOP" />
            </intent-filter>
        </receiver>

        <service
            android:name=".downloads.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.downloads"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/download_paths" />
        </provider>
    </application>
</manifest>