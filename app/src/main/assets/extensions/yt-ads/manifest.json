{
  "manifest_version": 2,
  "name": "Orbis YouTube ad estimate",
  "version": "1.3",
  "description": "Counts YouTube ad breaks from the player response, without changing it, so Orbis can estimate time saved. Sends nothing off the phone. Does not run in private tabs.",
  "browser_specific_settings": { "gecko": { "id": "yt-ads@orbis.shibi.com" } },
  "incognito": "not_allowed",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "nativeMessaging",
    "geckoViewAddons",
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.youtu.be/*",
    "*://youtu.be/*",
    "*://youtubei.googleapis.com/*",
    "*://*.youtubei.googleapis.com/*",
    "*://*.doubleclick.net/*",
    "*://*.googlesyndication.com/*",
    "*://*.googleadservices.com/*"
  ],
  "background": { "scripts": ["player.js", "background.js"] },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://youtu.be/*",
        "*://*.youtu.be/*"
      ],
      "js": ["title.js"],
      "run_at": "document_start"
    }
  ]
}
