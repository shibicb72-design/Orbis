<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The wording is fixed by the brief ("Found 1 peers" included), so no plurals. What a torrent row says while it looks for peers (tor10-4). English only: not translatable. -->
    <string name="torrent_search_looking" translatable="false">Looking for peers…</string>
    <string name="torrent_search_found" translatable="false" tools:ignore="PluralsCandidate">Found %1$d peers, connecting…</string>
    <string name="torrent_search_connected" translatable="false" tools:ignore="PluralsCandidate">Connected to %1$d of %2$d peers</string>
    <string name="torrent_search_none" translatable="false">No peers found yet. This torrent may have few or no seeders.</string>
    <string name="torrent_search_none_trackers_only" translatable="false">No peers found yet. This torrent can only ask its own trackers.</string>
    <!-- Added after one of the two lines above or "Looking for peers…", with a space in front. -->
    <string name="torrent_search_trackers_failed" translatable="false" tools:ignore="PluralsCandidate">None of this torrent\'s %1$d trackers answered.</string>
    <!-- Under "Waiting for Wi-Fi", which shows only for people who turned Wi-Fi only on. -->
    <string name="torrent_search_wifi_only_note" translatable="false">You turned on Wi-Fi only. Change it in Settings &gt; Torrents.</string>
</resources>
