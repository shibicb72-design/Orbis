<?xml version="1.0" encoding="utf-8"?>
<!-- Only the two download directories are shareable. The downloads index (filesDir/downloads_index.json) and
     everything else under filesDir stays unreachable through the FileProvider. "Download" is
     Environment.DIRECTORY_DOWNLOADS, the type passed to getExternalFilesDir. -->
<paths>
    <external-files-path name="downloads_external" path="Download/" />
    <files-path name="downloads_internal" path="downloads/" />
</paths>
