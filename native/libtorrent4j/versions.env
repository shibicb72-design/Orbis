# What the torrent natives bundle: the single record, read by scripts/check_engine_currency.py.
# Until the self-built natives ship (security PR 7) these are the values measured in the upstream
# libtorrent4j 2.1.0-39 jars (byte scan of lib/arm64-v8a and lib/x86_64 libtorrent4j.so, 2026-11-11).
# See docs/security/NATIVE-VERSIONS.md.
LIBTORRENT4J_VERSION=2.1.0-39
LIBTORRENT_VERSION=2.1.0.0
OPENSSL_VERSION=3.5.5
OPENSSL_SERIES=3.5
SOURCE=upstream-maven
