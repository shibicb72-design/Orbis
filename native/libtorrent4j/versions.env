# What the torrent natives bundle: the single record, read by scripts/check_engine_currency.py and by the
# Android CI check of the built APKs and bundle (OPENSSL_VERSION is the minimum there).
# The natives are app/src/main/jniLibs/<abi>/libtorrent4j.so, built by .github/workflows/torrent-natives.yml in
# run RUN_ID (hashes in CHECKSUMS.sha256). Java API: org.libtorrent4j:libtorrent4j LIBTORRENT4J_VERSION from Maven
# Central. See docs/security/NATIVE-VERSIONS.md.
LIBTORRENT4J_VERSION=2.1.0-39
LIBTORRENT_VERSION=2.1.0.0
OPENSSL_VERSION=3.5.9
OPENSSL_SERIES=3.5
SOURCE=orbis-ci
RUN_ID=43144313707
