# Every input of the torrent natives build (.github/workflows/torrent-natives.yml, native/libtorrent4j/build.sh).
# Plain KEY=VALUE lines, no quotes, no shell expansion: build.sh and the Python scripts both read this file.
# Where each value comes from: docs/security/NATIVE-VERSIONS.md, "How the natives are built".

# libtorrent4j source: tag v2.1.0-39 (the release whose Java jar Orbis uses from Maven Central).
LIBTORRENT4J_REPO=https://github.com/aldenml/libtorrent4j
LIBTORRENT4J_COMMIT=da7d2403f06a0939bc2c51a88e67a6c4a85512ef
# Submodule swig/deps/libtorrent at that commit (version.hpp: 2.1.0.0). Asserted, not chosen.
LIBTORRENT_COMMIT=24a3adf35d3e689bde700371337aad61b160bafa
LIBTORRENT_VERSION=2.1.0.0

# OpenSSL: the one input that differs from upstream's android.yml (3.5.5 there).
# SHA-256 from the .sha256 file published next to the tarball (GitHub release and www.openssl.org agree).
OPENSSL_VERSION=3.5.9
OPENSSL_URL=https://github.com/openssl/openssl/releases/download/openssl-3.5.9/openssl-3.5.9.tar.gz
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
# OpenSSL embeds its build time ("built on: ..."); util/mkbuildinf.pl takes it from SOURCE_DATE_EPOCH when set.
# 1790640000 = 2026-09-29T00:00:00Z, the 3.5.9 release date. Change it together with OPENSSL_VERSION.
# Exported for the OpenSSL step only, so repeat builds are byte-identical.
OPENSSL_SOURCE_DATE_EPOCH=1790640000
# Upstream android.yml line 16, unchanged.
OPENSSL_NO_OPTS=no-deprecated no-shared no-makedepend no-static-engine no-stdio no-posix-io no-threads no-ui-console no-zlib no-zlib-dynamic -fno-strict-aliasing -fvisibility=hidden -O3

# Boost: upstream's URL. SHA-256 as published on https://www.boost.org/releases/1.90.0/ and in
# https://archives.boost.io/release/1.90.0/source/boost_1_90_0.tar.gz.json.
BOOST_VERSION=1.90.0
BOOST_URL=https://archives.boost.io/release/1.90.0/source/boost_1_90_0.tar.gz
BOOST_SHA256=5e93d582aff26868d581a52ae78c7d8edf3f3064742c6e77901a1f18a437eea9

# Android NDK: upstream's URL. Google publishes a SHA-1 only (SDK repository manifest
# https://dl.google.com/android/repository/repository2-3.xml, "NDK (Side by side) 29.0.14206865", and
# https://github.com/android/ndk/wiki/Unsupported-Downloads). Both are checked; the SHA-256 was computed from a
# download whose SHA-1 and size matched the published values.
NDK_VERSION=r29
NDK_URL=https://dl.google.com/android/repository/android-ndk-r29-linux.zip
NDK_SHA1=87e2bb7e9be5d6a1c6cdf5ec40dd4e0c6d07c30b
NDK_SHA256=4abbbcdc842f3d4879206e9695d52709603e52dd68d3c1fff04b3b5e7a308ecf
NDK_SIZE=783549481

RUNNER=ubuntu-24.04

# Baseline: upstream's released natives (Maven Central, org.libtorrent4j:libtorrent4j-android-<x>:2.1.0-39).
# Byte-identical to the libtorrent4j.so files in the Orbis 0.6.0 release bundle.
UPSTREAM_JAR_VERSION=2.1.0-39
UPSTREAM_JAR_SHA256_arm64-v8a=59aa4c32c0dc62c95e24c2e3fdf805624625a1f8214e2442fae492e381ecbbdc
UPSTREAM_JAR_SHA256_armeabi-v7a=914157778f514661aabe4d3e72451c1d3004401ce6659407ab7ce94a3f273fbc
UPSTREAM_JAR_SHA256_x86_64=07ed97a0cbffbd8573a838e42549aa139b04d00ae2769eeef1a6a5402aba0cf3
UPSTREAM_SO_SHA256_arm64-v8a=6428158f8e012f048f85eb790317e55cf8557ba4018d53e543e86dd9c25cef2f
UPSTREAM_SO_SHA256_armeabi-v7a=f8fbe9f7ba3703092d05bbd8ea39b75227cbd3b84c43aeefa5798464e018863c
UPSTREAM_SO_SHA256_x86_64=5c48c09033912792451ebe8d0c495b9655ce44c921bed8c78b2e08a7c1d6a399
